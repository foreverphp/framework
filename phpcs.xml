<?xml version="1.0"?>
<ruleset name="Custom PHPCS Rules">
    <!-- Incluye estándares base -->
    <rule ref="PSR12"/>

    <!-- Configuraciones visuales -->
    <config name="colors" value="1"/>
    <config name="show_progress" value="1"/>
    <config name="report_width" value="120"/>

    <!-- Reglas específicas de Slevomat -->
    <rule ref="SlevomatCodingStandard.Namespaces.UnusedUses">
      <type>warning</type>
      <severity>5</severity>
    </rule>
    <rule ref="SlevomatCodingStandard.Namespaces.UseFromSameNamespace"/>

    <!-- Detecta parametros y variables sin uso -->
    <!--<rule ref="SlevomatCodingStandard.Functions.UnusedParameter"/>
    <rule ref="SlevomatCodingStandard.Variables.UnusedVariable"/>-->

    <!-- Excluir directorios -->
    <exclude-pattern>backups/*</exclude-pattern>
    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>node_modules/*</exclude-pattern>
</ruleset>
